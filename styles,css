:root{
      --black:#050505;
      --dark:#0b0b0d;
      --panel:#111114;
      --panel2:#17171c;
      --red:#d00000;
      --red2:#ff1a1a;
      --text:#f6f6f6;
      --muted:#b5b5b5;
      --line:rgba(255,255,255,.12);
      --glass:rgba(0,0,0,.68);
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      background:var(--black);
      color:var(--text);
      font-family:Inter,system-ui,-apple-system,Segoe UI,Arial,sans-serif;
      overflow-x:hidden;
    }
    a{color:inherit;text-decoration:none}

    .top-alert{
      background:linear-gradient(90deg,#6b0000,var(--red),#6b0000);
      text-align:center;
      padding:9px 14px;
      font-weight:900;
      letter-spacing:.08em;
      font-size:13px;
      text-transform:uppercase;
    }

    header{
      position:sticky;
      top:0;
      z-index:50;
      background:rgba(0,0,0,.82);
      backdrop-filter:blur(14px);
      border-bottom:1px solid rgba(255,255,255,.12);
    }
    .nav{
      max-width:1220px;
      margin:auto;
      padding:16px 22px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:20px;
    }
    .brand{
      display:flex;
      align-items:center;
      gap:12px;
    }
    .brand-logo{
      width:190px;
      max-width:32vw;
      height:auto;
      display:block;
      filter:drop-shadow(0 0 16px rgba(255,255,255,.18));
    }
    nav{
      display:flex;
      align-items:center;
      gap:22px;
      font-size:13px;
      font-weight:900;
      text-transform:uppercase;
    }
    nav a{opacity:.9}
    nav a:hover{color:var(--red2)}
    .nav-call{
      padding:12px 18px;
      border-radius:999px;
      background:var(--red);
      box-shadow:0 0 28px rgba(208,0,0,.45);
    }

    .hero{
      position:relative;
      min-height:88vh;
      display:grid;
      align-items:center;
      overflow:hidden;
      background:
        linear-gradient(90deg,rgba(0,0,0,.93),rgba(0,0,0,.62),rgba(0,0,0,.2)),
        radial-gradient(circle at 80% 35%,rgba(255,0,0,.38),transparent 34%),
        url('https://images.unsplash.com/photo-1556912173-3bb406ef7e77?auto=format&fit=crop&w=1800&q=85') center/cover no-repeat;
    }
    .hero:after{
      content:"";
      position:absolute;
      inset:0;
      background:linear-gradient(0deg,#050505 0%,transparent 20%,transparent 70%,rgba(0,0,0,.5) 100%);
      pointer-events:none;
    }
    .hero-inner{
      position:relative;
      z-index:2;
      max-width:1220px;
      margin:auto;
      padding:70px 22px;
      width:100%;
    }
    .badge-row{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
      margin-bottom:18px;
    }
    .badge{
      border:1px solid rgba(255,255,255,.22);
      background:rgba(0,0,0,.52);
      padding:10px 13px;
      border-radius:999px;
      font-size:12px;
      font-weight:900;
      text-transform:uppercase;
      letter-spacing:.08em;
    }
    h1{
      font-family:"Bebas Neue",Inter,sans-serif;
      font-size:clamp(62px,10vw,148px);
      line-height:.86;
      margin:0;
      letter-spacing:.02em;
      text-shadow:0 0 28px #000;
    }
    h1 em{
      display:block;
      color:var(--red2);
      font-style:normal;
      text-shadow:0 0 34px rgba(255,0,0,.55);
    }
    .hero p{
      max-width:720px;
      font-size:clamp(18px,2.4vw,25px);
      color:#e6e6e6;
      line-height:1.45;
      margin:20px 0 0;
    }
    .actions{
      display:flex;
      flex-wrap:wrap;
      gap:14px;
      margin-top:30px;
    }
    .btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:10px;
      padding:16px 26px;
      border-radius:14px;
      font-weight:900;
      text-transform:uppercase;
      letter-spacing:.06em;
      border:1px solid rgba(255,255,255,.12);
      transition:.25s ease;
    }
    .btn-red{background:var(--red);box-shadow:0 0 32px rgba(208,0,0,.48)}
    .btn-dark{background:rgba(255,255,255,.08);backdrop-filter:blur(10px)}
    .btn:hover{transform:translateY(-3px);filter:brightness(1.15)}

    .stats{
      display:grid;
      grid-template-columns:repeat(3,minmax(0,1fr));
      gap:14px;
      max-width:760px;
      margin-top:42px;
    }
    .stat{
      background:rgba(0,0,0,.6);
      border:1px solid rgba(255,255,255,.14);
      border-radius:18px;
      padding:18px;
    }
    .stat strong{
      display:block;
      color:var(--red2);
      font-size:25px;
      font-weight:900;
    }
    .stat span{font-size:13px;color:var(--muted);font-weight:800;text-transform:uppercase}

    section{
      max-width:1220px;
      margin:auto;
      padding:86px 22px;
    }
    .section-title{
      display:flex;
      align-items:end;
      justify-content:space-between;
      gap:24px;
      margin-bottom:34px;
    }
    h2{
      font-family:"Bebas Neue",Inter,sans-serif;
      font-size:clamp(42px,6vw,78px);
      line-height:.95;
      margin:0;
      letter-spacing:.03em;
    }
    h2 span{color:var(--red2)}
    .section-title p{
      max-width:480px;
      color:var(--muted);
      line-height:1.55;
      margin:0;
      font-weight:600;
    }

    .service-grid{
      display:grid;
      grid-template-columns:repeat(4,minmax(0,1fr));
      gap:18px;
    }
    .service-card{
      min-height:330px;
      border-radius:24px;
      overflow:hidden;
      position:relative;
      border:1px solid var(--line);
      background:#111;
      box-shadow:0 18px 60px rgba(0,0,0,.35);
    }
    .service-card:before{
      content:"";
      position:absolute;
      inset:0;
      background:linear-gradient(0deg,rgba(0,0,0,.9),rgba(0,0,0,.18));
      z-index:1;
    }
    .service-card img{
      width:100%;
      height:100%;
      object-fit:cover;
      position:absolute;
      inset:0;
      transition:.5s ease;
      filter:saturate(1.1) contrast(1.05);
    }
    .service-card:hover img{transform:scale(1.08)}
    .service-content{
      position:absolute;
      left:0;right:0;bottom:0;
      z-index:2;
      padding:22px;
    }
    .service-content h3{
      margin:0 0 8px;
      font-size:22px;
      line-height:1.1;
    }
    .service-content p{
      margin:0;
      color:#d1d1d1;
      line-height:1.45;
      font-size:14px;
    }

    .service-area-banner{
      background:linear-gradient(135deg,rgba(255,255,255,.08),rgba(255,255,255,.03));
      border:1px solid var(--line);
      border-radius:30px;
      padding:45px 35px;
      text-align:center;
      box-shadow:0 20px 60px rgba(0,0,0,.35);
    }
    .service-area-banner h3{
      font-size:42px;
      margin:0 0 20px;
      font-family:"Bebas Neue",Inter,sans-serif;
      letter-spacing:.04em;
    }
    .service-area-tags{
      display:flex;
      justify-content:center;
      flex-wrap:wrap;
      gap:14px;
      margin-top:20px;
    }
    .service-tag{
      background:rgba(0,0,0,.45);
      border:1px solid rgba(255,255,255,.12);
      padding:14px 22px;
      border-radius:999px;
      font-weight:900;
      font-size:15px;
      letter-spacing:.04em;
    }
    .service-tag:before{content:"●";color:var(--red2);margin-right:8px}

    .about-band{
      max-width:none;
      background:
        linear-gradient(90deg,rgba(0,0,0,.88),rgba(0,0,0,.55)),
        url('https://images.unsplash.com/photo-1607472586893-edb57bdc0e39?auto=format&fit=crop&w=1800&q=85') center/cover no-repeat;
      border-top:1px solid var(--line);
      border-bottom:1px solid var(--line);
    }
    .about-inner{
      max-width:1220px;
      margin:auto;
      padding:90px 22px;
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:40px;
      align-items:center;
    }
    .glass{
      background:rgba(0,0,0,.66);
      border:1px solid rgba(255,255,255,.15);
      border-radius:28px;
      padding:34px;
      backdrop-filter:blur(12px);
    }
    .glass p{color:#dfdfdf;line-height:1.7;font-size:17px}

    .quote{
      display:grid;
      grid-template-columns:.9fr 1.1fr;
      gap:24px;
      align-items:start;
    }
    .quote-card{
      background:linear-gradient(180deg,rgba(255,255,255,.08),rgba(255,255,255,.03));
      border:1px solid var(--line);
      border-radius:28px;
      padding:30px;
    }
    label{display:block;font-weight:900;margin:14px 0 8px;text-transform:uppercase;font-size:12px;letter-spacing:.08em;color:#ddd}
    input,select,textarea{
      width:100%;
      background:#0d0d10;
      border:1px solid rgba(255,255,255,.14);
      color:white;
      border-radius:14px;
      padding:15px;
      font-size:16px;
      outline:none;
    }
    textarea{min-height:130px;resize:vertical}
    button{cursor:pointer;width:100%;border:0;margin-top:18px}

    footer{
      background:#000;
      border-top:3px solid var(--red);
      padding:50px 22px 90px;
      text-align:center;
      color:var(--muted);
    }
    footer strong{color:white}

    .mobile-bar{
      position:fixed;
      left:12px;
      right:12px;
      bottom:12px;
      z-index:60;
      display:none;
      grid-template-columns:1fr 1fr 1fr;
      gap:8px;
      background:rgba(0,0,0,.78);
      backdrop-filter:blur(12px);
      border:1px solid rgba(255,255,255,.16);
      border-radius:18px;
      padding:8px;
    }
    .mobile-bar a{
      text-align:center;
      background:var(--red);
      border-radius:13px;
      padding:12px 8px;
      font-weight:900;
      font-size:13px;
    }

    @media(max-width:980px){
      nav{display:none}
      .service-grid{grid-template-columns:repeat(2,1fr)}
      .map-wrap,.about-inner,.quote{grid-template-columns:1fr}
      .reviews{grid-template-columns:1fr}
      .section-title{display:block}
      .section-title p{margin-top:12px}
      .stats{grid-template-columns:1fr}
      .mobile-bar{display:grid}
    }
    @media(max-width:620px){
      .hero{min-height:82vh}
      .service-grid{grid-template-columns:1fr}
      .areas{grid-template-columns:1fr}
      .pin:after{font-size:10px}
      .p6{left:310px}.p3{left:280px}.p5{left:270px}
    }
